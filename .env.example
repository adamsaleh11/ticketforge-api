# Copy to .env and fill in. Loaded by dotenv-rails in development/test only.
# In production (Render), set these as real environment variables instead.

# Postgres connection string for Supabase. MUST include sslmode=require.
# Use the Session pooler URI (IPv4-friendly), e.g.:
#   postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# Supabase project URL, e.g. https://PROJECT.supabase.co
# Access tokens are ES256-signed and verified against this project's public
# JWKS at {SUPABASE_URL}/auth/v1/.well-known/jwks.json, so this MUST be set.
SUPABASE_URL=

# Legacy symmetric JWT secret. No longer used: Supabase issues asymmetric
# (ES256) tokens verified via the JWKS above. Kept only for reference; safe to
# leave blank.
SUPABASE_JWT_SECRET=

# API key for Groq (LLM provider).
GROQ_API_KEY=

# Origin of the deployed Next.js frontend (ticketforge-web), used for CORS.
# Example: https://ticketforge.vercel.app
FRONTEND_URL=

# Active Record encryption keys for `encrypts` attributes (e.g. User#github_access_token).
# Generate a set with: bin/rails db:encryption:init
# In production (Render) set these as real environment variables. The test suite
# uses fixed values baked into config/environments/test.rb and ignores these.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
