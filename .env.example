# Copy to .env and fill in. Loaded by dotenv-rails in development/test only.
# In production (Render), set these as real environment variables instead.

# Postgres connection string. In production this points at Supabase and MUST
# include sslmode=require. Supabase's pooler URL already carries it, e.g.:
#   postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require
# Leave unset locally to use the database names in config/database.yml.
DATABASE_URL=

# Secret used to sign devise-jwt tokens. Generate with: bin/rails secret
DEVISE_JWT_SECRET_KEY=

# API key for Groq (OpenAI-compatible LLM endpoint).
GROQ_API_KEY=

# Origin of the deployed Next.js frontend (ticketforge-web), used for CORS.
# Example: https://ticketforge.vercel.app
FRONTEND_URL=

# GitHub OAuth app credentials (read-only repo context).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
